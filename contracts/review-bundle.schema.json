{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "method-wiki-review-bundle/1.0.0",
  "title": "Method Wiki Review Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "route", "source_sha256", "wiki_context", "items"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "route": {"enum": ["isolated_bootstrap", "upgrade_existing"]},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "wiki_context": {
      "type": "object", "additionalProperties": false,
      "required": ["wiki_dir", "baseline_sha256", "source_index", "sources", "modules", "change_set_path", "change_set_sha256"],
      "properties": {
        "wiki_dir": {"type": "string", "minLength": 1},
        "baseline_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "source_index": {"type": "string", "minLength": 1},
        "change_set_path": {"type": "string", "minLength": 1},
        "change_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "modules": {"type": "array", "items": {"$ref": "#/$defs/module"}}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "method_kind", "source_id", "source_module_id", "module_meta", "proposal", "recommended_action", "allowed_decisions", "merge_targets", "module_targets", "comparison"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^review_[a-f0-9]{24}$"},
          "method_kind": {"enum": ["lens", "recipe"]},
          "source_id": {"type": "string", "minLength": 1},
          "source_module_id": {"type": ["string", "null"]},
          "module_meta": {"type": ["object", "null"], "additionalProperties": false,
            "required": ["title_zh", "stable_decision_zh", "unified_preconditions_zh", "page_expression_options"],
            "properties": {"title_zh": {"type": "string"}, "stable_decision_zh": {"type": "string"},
              "unified_preconditions_zh": {"type": "array", "items": {"type": "string"}},
              "page_expression_options": {"type": "array", "items": {"type": "object"}}}},
          "proposal": {"type": "object"},
          "recommended_action": {"type": ["string", "null"]},
          "allowed_decisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "merge_targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
          "module_targets": {"type": "array", "items": {"$ref": "#/$defs/moduleTarget"}},
          "comparison": {"type": ["object", "null"]}
        }
      }
    }
  },
  "$defs": {
    "source": {"type": "object", "additionalProperties": false,
      "required": ["source_module_instance_id", "source_id", "locator"],
      "properties": {"source_module_instance_id": {"type": "string", "pattern": "^mi_[a-f0-9]{24}$"},
        "source_id": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}}},
    "module": {"type": "object", "additionalProperties": false,
      "required": ["module_id", "title", "stable_decision", "unified_preconditions", "page_expression_options"],
      "properties": {"module_id": {"type": "string", "pattern": "^mod_[a-z0-9][a-z0-9-]{2,63}$"},
        "title": {"type": "string", "minLength": 1}, "stable_decision": {"type": "string", "minLength": 1},
        "unified_preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "page_expression_options": {"type": "array", "items": {"type": "object"}}}},
    "target": {"type": "object", "additionalProperties": false,
      "required": ["module_id", "target_id", "label_zh", "target"],
      "properties": {"module_id": {"type": ["string", "null"]}, "target_id": {"type": "string", "minLength": 1},
        "label_zh": {"type": "string"}, "module_title_zh": {"type": "string"}, "question_zh": {"type": "string"},
        "target": {"type": "object"}}},
    "moduleTarget": {"type": "object", "additionalProperties": false,
      "required": ["module_id", "label_zh", "target"],
      "properties": {"module_id": {"type": "string", "minLength": 1}, "label_zh": {"type": "string"}, "target": {"type": "object"}}}
  }
}
